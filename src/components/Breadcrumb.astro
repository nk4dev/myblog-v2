---
type Props = {
  /** 最後の項目の表示名（記事タイトルなど）。省略時は URL から決める */
  current?: string;
};

const { current } = Astro.props;

// URL の区切りごとの表示名。載っていないものはそのまま表示する
const labels: Record<string, string> = {
  blog: "Blog",
  scraps: "Scraps",
};

const segments = Astro.url.pathname.split("/").filter(Boolean);
const items = [
  { href: "/", label: "Home" },
  ...segments.map((segment, i) => ({
    href: `/${segments.slice(0, i + 1).join("/")}/`,
    label: labels[segment] ?? decodeURIComponent(segment),
  })),
];
if (current) items[items.length - 1].label = current;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap">
    {
      items.map((item, i) =>
        i < items.length - 1 ? (
          <li>
            <a href={item.href} class="hover:underline">{item.label}</a>
            <span aria-hidden="true"> / </span>
          </li>
        ) : (
          <li aria-current="page">{item.label}</li>
        ),
      )
    }
  </ol>
</nav>
