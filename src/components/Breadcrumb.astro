---
type Props = {
  /** 最後の項目の表示名（記事タイトルなど）。省略時は URL から決める */
  current?: string;
  class?: string;
};

const { current, class: className } = Astro.props;

// URL の区切りごとの表示名。載っていないものはそのまま表示する
const labels: Record<string, string> = {
  blog: "Blog",
  scraps: "Scraps",
};

const segments = Astro.url.pathname.split("/").filter(Boolean);
const items = [
  { href: "/", label: "Home" },
  ...segments.map((segment, i) => ({
    href: `/${segments.slice(0, i + 1).join("/")}/`,
    label: labels[segment] ?? decodeURIComponent(segment),
  })),
];
if (current) items[items.length - 1].label = current;

// パンくずはブログとスクラップの配下だけに出す（トップや 404 では出さない）
const visible = segments[0] in labels;
---

{visible && (
<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex min-w-0">
    {
      items.map((item, i) =>
        i < items.length - 1 ? (
          <li class="shrink-0">
            <a href={item.href} class="underline-offset-4 hover:underline">{item.label}</a>
            <span aria-hidden="true" class="px-2 opacity-60">/</span>
          </li>
        ) : (
          <li aria-current="page" class="min-w-0 truncate" title={item.label}>{item.label}</li>
        ),
      )
    }
  </ol>
</nav>
)}
