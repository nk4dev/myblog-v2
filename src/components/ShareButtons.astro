---
import ShareX from "./ShareX.astro";
import T from "./T.astro";
import { i18nAttrs, ui, type UIKey } from "../i18n/ui";
import { SITE_HASHTAGS, blueskyShareURL, hatenaShareURL, lineShareURL, withUtm } from "../lib/share";

/**
 * Share row for article pages: X as the main button, then icon buttons for other services,
 * copying the link, and the device's own share sheet (only where the browser has one).
 */
type Props = {
  text: string;
  url: string | URL;
  /** Added after the site-wide hashtags */
  hashtags?: string[];
};

const { text, url, hashtags = [] } = Astro.props;
const target = { text, url: String(url), hashtags: [...SITE_HASHTAGS, ...hashtags], placement: "article" as const };

// Brand marks from Simple Icons (CC0), 24×24 viewBox
const services: { label: UIKey; method: string; href: string; path: string }[] = [
  {
    label: "share.bluesky",
    method: "bluesky",
    href: blueskyShareURL(target),
    path: "M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026",
  },
  {
    label: "share.hatena",
    method: "hatena",
    href: hatenaShareURL(target),
    path: "M20.47 0C22.42 0 24 1.58 24 3.53v16.94c0 1.95-1.58 3.53-3.53 3.53H3.53C1.58 24 0 22.42 0 20.47V3.53C0 1.58 1.58 0 3.53 0h16.94zm-3.705 14.47c-.78 0-1.41.63-1.41 1.41s.63 1.414 1.41 1.414 1.41-.645 1.41-1.425-.63-1.41-1.41-1.41zM8.61 17.247c1.2 0 2.056-.042 2.58-.12.526-.084.976-.222 1.32-.412.45-.232.78-.564 1.02-.99s.36-.915.36-1.48c0-.78-.21-1.403-.63-1.87-.42-.48-.99-.734-1.74-.794.66-.18 1.156-.45 1.456-.81.315-.344.465-.824.465-1.424 0-.48-.103-.885-.3-1.26-.21-.36-.493-.645-.883-.87-.345-.195-.735-.315-1.215-.405-.464-.074-1.29-.12-2.474-.12H5.654v10.486H8.61zm.736-4.185c.705 0 1.185.088 1.44.262.27.18.39.495.39.93 0 .405-.135.69-.42.855-.27.18-.765.254-1.44.254H8.31v-2.297h1.05zm8.656.706v-7.06h-2.46v7.06H18zM8.925 9.08c.71 0 1.185.08 1.432.24.245.16.367.435.367.83 0 .38-.13.646-.39.804-.265.154-.747.232-1.452.232h-.57V9.08h.615z",
  },
  {
    label: "share.line",
    method: "line",
    href: lineShareURL(target),
    path: "M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314",
  },
];

const iconButton =
  "group relative grid size-9 place-items-center rounded-full border border-[var(--link)]/40 text-[var(--link)] transition-colors hover:bg-[var(--mark)]";
// Name shown above an icon button on hover or keyboard focus. Screen readers already get it from aria-label
const tooltip =
  "pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 rounded bg-[var(--ink)] px-2 py-1 text-xs font-medium whitespace-nowrap text-[var(--paper)] opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100";
---

<div
  class="flex flex-wrap items-center gap-2"
  data-share
  data-share-title={text}
  data-share-copy-url={withUtm(target.url, "copy", target.placement)}
  data-share-native-url={withUtm(target.url, "native", target.placement)}
>
  <ShareX text={text} url={url} hashtags={hashtags} placement={target.placement} variant="button" class="mr-1" />
  {
    services.map(({ label, method, href, path }) => (
      <a
        href={href}
        data-share-method={method}
        data-share-placement={target.placement}
        target="_blank"
        rel="noopener noreferrer"
        class={iconButton}
        aria-label={ui.ja[label]}
        {...i18nAttrs(label, "aria-label")}
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
          <path d={path} />
        </svg>
        <span class={tooltip} aria-hidden="true">
          <T k={label} />
        </span>
      </a>
    ))
  }
  <button type="button" class={iconButton} data-share-copy data-share-method="copy" data-share-placement={target.placement} aria-label={ui.ja["share.copy"]} {...i18nAttrs("share.copy", "aria-label")}>
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L12 5.6M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2"></path>
    </svg>
    <span class={tooltip} aria-hidden="true">
      <T k="share.copy" />
    </span>
  </button>
  <!-- Revealed by the script only where navigator.share exists (mostly phones) -->
  <button
    type="button"
    class:list={[iconButton, "hidden"]}
    data-share-native
    data-share-method="native"
    data-share-placement={target.placement}
    aria-label={ui.ja["share.native"]}
    {...i18nAttrs("share.native", "aria-label")}
  >
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 15V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"></path>
    </svg>
    <span class={tooltip} aria-hidden="true">
      <T k="share.native" />
    </span>
  </button>
  <span role="status" class="text-sm text-[var(--ink-soft)]" data-share-status hidden>
    <T k="share.copied" />
  </span>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-share]").forEach((root) => {
    // Each action shares its own UTM-tagged URL so the source shows up in analytics
    const copyUrl = root.dataset.shareCopyUrl!;
    const nativeUrl = root.dataset.shareNativeUrl!;
    const title = root.dataset.shareTitle ?? document.title;
    const status = root.querySelector<HTMLElement>("[data-share-status]")!;
    let timer: number | undefined;

    root.querySelector("[data-share-copy]")!.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copyUrl);
      } catch {
        // Clipboard access can be refused (e.g. insecure context); let the reader copy it by hand
        prompt("URL", copyUrl);
        return;
      }
      status.hidden = false;
      clearTimeout(timer);
      timer = window.setTimeout(() => (status.hidden = true), 2000);
    });

    const native = root.querySelector<HTMLButtonElement>("[data-share-native]")!;
    if (typeof navigator.share === "function") {
      native.classList.remove("hidden");
      native.addEventListener("click", () => {
        // Rejects when the reader closes the sheet; nothing to do then
        navigator.share({ title, url: nativeUrl }).catch(() => {});
      });
    }
  });
</script>
