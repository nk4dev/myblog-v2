---
import T from "./T.astro";
import { SITE_HASHTAGS, xShareURL, type SharePlacement } from "../lib/share";

/** Link that opens X's post composer with this page's title, URL and hashtags filled in */
type Props = {
  text: string;
  url: string | URL;
  /** Added after the site-wide hashtags */
  hashtags?: string[];
  /** Sent as utm_content so shares from the article and the footer can be told apart */
  placement?: SharePlacement;
  /** "link" blends into text; "button" is a filled pill that stands out */
  variant?: "link" | "button";
  class?: string;
};

const { text, url, hashtags = [], placement, variant = "link", class: className } = Astro.props;
const href = xShareURL({ text, url: String(url), hashtags: [...SITE_HASHTAGS, ...hashtags], placement });
---

<a
  href={href}
  data-share-method="x"
  data-share-placement={placement}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex items-center gap-1.5 font-medium",
    variant === "button"
      ? "rounded-full bg-[var(--brand)] px-4 py-1.5 text-white ring-1 ring-white/20 transition-opacity hover:opacity-85"
      : "mark",
    className,
  ]}
>
  <svg viewBox="0 0 24 24" class="size-[1em] shrink-0" fill="currentColor" aria-hidden="true">
    <path
      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
    ></path>
  </svg>
  <T k="share.x" />
</a>
