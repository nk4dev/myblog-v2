---
/** 一覧ページの見出し。件数を寸法のように右肩へ書き込む */
import T from "./T.astro";
import type { UIKey } from "../i18n/ui";

interface Props {
  title: string;
  lead: UIKey;
  count: number;
}

const { title, lead, count } = Astro.props;
---

<header class="page-head">
  <h1 class="page-title">{title}</h1>
  <div class="page-meta">
    <p class="page-lead"><T k={lead} /></p>
    <p class="note">{String(count).padStart(2, "0")}<T k="list.count" /></p>
    <slot />
  </div>
</header>

<style>
  .page-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .page-title {
    font-size: clamp(4rem, 15vw, 10rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.82;
    /* ディセンダー（Blog の g）の分だけ下を空ける */
    padding-bottom: 0.2em;
    letter-spacing: -0.03em;
  }
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  .page-lead {
    color: var(--ink-soft);
  }
  @media (min-width: 768px) {
    .page-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .page-meta {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
