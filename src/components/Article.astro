---
/**
 * 記事・スクラップ詳細の本文部分。
 * 広い画面では左に目次を置き、読んでいる節を赤で示す。
 */
import T from "./T.astro";
import type { UIKey } from "../i18n/ui";
import { formatDate } from "../lib/date";
import { readingMinutes, withHeadings } from "../lib/toc";

interface Props {
  title: string;
  content: string;
  publishedAt: string;
  revisedAt?: string;
  category?: string;
  eyecatch?: { url: string; width: number; height: number };
  back: { href: string; label: UIKey };
  /** 図面枠のラベル */
  kind: "article" | "scrap";
}

const { title, content, publishedAt, revisedAt, category, eyecatch, back, kind } = Astro.props;
const { html, headings } = withHeadings(content);
const minutes = readingMinutes(content);
const published = formatDate(publishedAt);
const revised = revisedAt ? formatDate(revisedAt) : undefined;
---

<article lang="ja" class="article">
  <header class="article-head">
    <a href={back.href} class="note text-link article-back">
      <T k={back.label} />
    </a>
    <h1 class="article-title">{title}</h1>
    <dl class="article-meta note">
      <div>
        <dt class="sr-only">Published</dt>
        <dd><time datetime={publishedAt}>{published}</time></dd>
      </div>
      {
        revised && revised !== published && (
          <div>
            <dt>rev.</dt>
            <dd>
              <time datetime={revisedAt}>{revised}</time>
            </dd>
          </div>
        )
      }
      {
        category && (
          <div>
            <dt class="sr-only">Category</dt>
            <dd class="entry-cat">{category}</dd>
          </div>
        )
      }
      <div>
        <dt class="sr-only">Reading time</dt>
        <dd>{minutes}<T k="article.minutes" /></dd>
      </div>
    </dl>
  </header>

  {
    eyecatch && (
      <figure class="article-eyecatch bp p-1" data-bp="fig. 1">
        <img src={`${eyecatch.url}?w=1600&fm=webp`} alt="" width={eyecatch.width} height={eyecatch.height} class="block h-auto w-full" />
      </figure>
    )
  }

  <div class="article-grid">
    {
      headings.length >= 2 && (
        <nav class="toc" aria-labelledby="toc-heading">
          <p id="toc-heading" class="note mb-3">
            <T k="article.toc" />
          </p>
          <ol>
            {headings.map((h) => (
              <li class:list={[h.level === 3 && "toc-sub"]}>
                <a href={`#${h.id}`} data-toc={h.id}>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="prose max-w-none article-body" data-kind={kind} set:html={html} />
  </div>

  <footer class="article-foot">
    <a href={back.href} class="text-link note"><T k={back.label} /></a>
    <a href="#main" class="text-link note"><T k="article.top" /></a>
  </footer>
</article>

<script>
  // 画面に入っている節の目次項目に印を付ける
  const links = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc]")).map((a) => [a.dataset.toc!, a]),
  );
  if (links.size > 0) {
    let current: HTMLAnchorElement | undefined;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          current?.removeAttribute("aria-current");
          current = links.get(entry.target.id);
          current?.setAttribute("aria-current", "true");
        }
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>

<style>
  .article-head {
    max-width: 52rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .article-back {
    display: inline-block;
    margin-bottom: 2.5rem;
  }
  .article-back::before,
  .article-foot a:first-child::before {
    content: "‹ ";
  }
  .article-title {
    font-size: clamp(1.875rem, 4.4vw, 3rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .article-meta > div {
    display: flex;
    gap: 0.4rem;
  }
  .article-eyecatch {
    margin-top: 3rem;
  }
  /* 透過画像でも青焼きの紙に沈まないよう、白い台紙に貼る */
  .article-eyecatch img {
    background: #f5f7fb;
  }
  .article-grid {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
  }
  .article-body {
    max-width: 40rem;
    min-width: 0;
    font-weight: 500;
  }
  .article-body > :global(:first-child) {
    margin-top: 0;
  }
  .toc {
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .toc ol {
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--ink-soft);
    transition:
      color 200ms,
      border-color 200ms;
  }
  .toc .toc-sub a {
    padding-left: 1.75rem;
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a[aria-current] {
    color: var(--ink);
    border-left-color: var(--red);
  }
  .article-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 1024px) {
    /* 見出しと本文の左端を揃える（目次の列 13rem + 間隔 4rem） */
    .article-head {
      margin-left: 17rem;
    }
    .article-grid {
      grid-template-columns: 13rem minmax(0, 40rem);
      gap: 4rem;
    }
    .article-grid:not(:has(.toc)) {
      grid-template-columns: minmax(0, 40rem);
      margin-left: 17rem;
    }
    .toc {
      position: sticky;
      top: 7rem;
      align-self: start;
      max-height: calc(100vh - 9rem);
      overflow: auto;
    }
  }
</style>
