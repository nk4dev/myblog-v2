---
/**
 * 図面の表題欄（タイトルブロック）風のフッター。
 * 表題にはページのタイトル、図番にはページのパスを入れる。
 */
import T from "./T.astro";
import { formatDate } from "../lib/date";
import { socialLinks } from "../data/social";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const year = new Date().getFullYear();
const builtAt = formatDate(new Date().toISOString());
const sheet = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<footer class="mx-auto w-full max-w-6xl px-5 pb-10 sm:px-10 lg:px-14">
  <div class="title-block">
    <div class="tb-name">
      <span class="tb-key"><T k="tb.title" /></span>
      <p class="tb-title" lang="ja">{title ?? "Nknight AMAMIYA"}</p>
    </div>
    <div class="tb-cell">
      <span class="tb-key"><T k="tb.drawn" /></span>
      <span>nk4dev</span>
    </div>
    <div class="tb-cell">
      <span class="tb-key"><T k="tb.date" /></span>
      <time datetime={builtAt}>{builtAt}</time>
    </div>
    <div class="tb-cell">
      <span class="tb-key"><T k="tb.scale" /></span>
      <span>1 : 1</span>
    </div>
    <div class="tb-cell">
      <span class="tb-key"><T k="tb.sheet" /></span>
      <span class="truncate">{sheet}</span>
    </div>
    <div class="tb-foot">
      <small>&copy; {year} Nknight AMAMIYA@nk4dev</small>
      <ul class="flex gap-4">
        {
          socialLinks.map((link) => (
            <li>
              <a href={`/${link.slug}`} class="text-link" rel="me">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .title-block {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--line-strong);
    font: 400 0.75rem/1.5 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .title-block > * {
    padding: 0.6rem 0.85rem;
    border: solid var(--line);
    border-width: 0 1px 1px 0;
    min-width: 0;
  }
  .tb-name {
    grid-column: 1 / -1;
  }
  .tb-key {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.625rem;
    color: var(--line-strong);
  }
  .tb-title {
    font: 700 1.25rem/1.35 var(--font-sans);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .tb-cell {
    display: flex;
    flex-direction: column;
  }
  .tb-foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-bottom: 0;
    color: var(--ink-soft);
  }
  @media (min-width: 768px) {
    .title-block {
      grid-template-columns: minmax(0, 2.2fr) repeat(4, minmax(0, 1fr));
    }
    .tb-name {
      grid-column: auto;
    }
    .title-block > :nth-child(5) {
      border-right: 0;
    }
  }
</style>
