---
/**
 * 記事・スクラップ一覧の 1 行（改訂履歴表の行）。<ol class="entries"> の中で使う。
 * no はその記事が何本目か（公開順）で、並び替えても記事と一緒に動く。
 */
import type { Blog } from "../types/blog";
import type { Scrap } from "../types/scrap";
import { formatDate } from "../lib/date";

interface Props {
  post: Blog | Scrap;
  /** 公開順の通し番号 */
  no: number;
  /** 詳細ページのパス（例: "/blog", "/scraps"） */
  basePath?: string;
}

const { post, no, basePath = "/blog" } = Astro.props;
const category = typeof post.category === "string" ? post.category : post.category?.name;
const description = "description" in post ? post.description : undefined;
const date = post.publishedAt ?? post.createdAt;
---

<li class="entry" data-date={date} data-title={post.title}>
  <a href={`${basePath}/${post.id}`}>
    <span class="entry-no" aria-hidden="true">{String(no).padStart(3, "0")}</span>
    <div class="entry-meta">
      <time datetime={date}>{formatDate(date)}</time>
      {category && <span class="entry-cat">{category}</span>}
    </div>
    <h3 lang="ja" class="entry-title">{post.title}</h3>
    {description && <p lang="ja" class="entry-desc line-clamp-2">{description}</p>}
  </a>
</li>
