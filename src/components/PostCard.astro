---
import type { Blog } from "../types/blog";
import type { Scrap } from "../types/scrap";

interface Props {
  post: Blog | Scrap;
  /** 詳細ページのパス（例: "/blog", "/scraps"） */
  basePath?: string;
}

const { post, basePath = "/blog" } = Astro.props;
const category = typeof post.category === "string" ? post.category : post.category?.name;
const description = "description" in post ? post.description : undefined;
const publishedDate = new Date(post.publishedAt ?? post.createdAt).toLocaleDateString("ja-JP");
---

<a
  href={`${basePath}/${post.id}`}
  class="bp block p-5 transition-colors hover:bg-blue-500/5"
  data-bp={basePath === "/scraps" ? "scrap" : "post"}
>
  <div class="mb-2 flex items-center gap-3 font-mono text-xs text-slate-500 dark:text-slate-400">
    <time datetime={post.publishedAt ?? post.createdAt}>{publishedDate}</time>
    {category && (
      <span class="bp-tag px-2 py-0.5 font-medium text-slate-600 dark:text-slate-400">
        {category}
      </span>
    )}
  </div>
  <h2 lang="ja" class="text-lg font-semibold text-slate-900 dark:text-slate-100">{post.title}</h2>
  {description && (
    <p class="mt-1 line-clamp-2 text-sm text-slate-600 dark:text-slate-400">{description}</p>
  )}
</a>
