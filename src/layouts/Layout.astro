---
import "../styles/global.css";
import HeaderLink from "../components/HeaderLink.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { socialLinks } from "../data/social";

type Props = {
  /** パンくずリストの最後に出す名前（記事タイトルなど） */
  title?: string;
};

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@75..112.5,300..500&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />
  </head>
  <body class="sm:px-5 md:px-24 xl:px-44 py-8">
    <header class="flex justify-between">
      <Breadcrumb current={title} />
      <div>
        <HeaderLink href="/blog/">Blog</HeaderLink>
        {socialLinks.map(({ url, label }) => (
          <>
            <span> / </span>
            <HeaderLink href={url}>{label}</HeaderLink>
          </>
        ))}
      </div>
    </header>
    <main id="main" class=" w-full">
      <slot />
    </main>
    <footer class="flex justify-between">
      <div>
        Nknight AMAMIYA@nk4dev
      </div>
      <div>
        All rights
      </div>
    </footer>
  </body>
</html>
