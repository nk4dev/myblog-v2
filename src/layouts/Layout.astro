---
import "../styles/global.css";
import HeaderLink from "../components/HeaderLink.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Logo from "../components/Logo.astro";
import Loader from "../components/Loader.astro";
import ShareX from "../components/ShareX.astro";
import Analytics from "../components/Analytics.astro";
import WebMCP from "../components/WebMCP.astro";
import T from "../components/T.astro";
import { canonicalURL } from "../lib/share";
import { markdownPath } from "../lib/markdown";
import { socialLinks } from "../data/social";
import { i18nAttrs, ui } from "../i18n/ui";

type Props = {
  /** ページ名。<title> とパンくずリストの最後に使う。省略時はトップページ扱い */
  title?: string;
  /** meta description。省略時はサイトの既定の説明文 */
  description?: string;
  /** 記事・スクラップの詳細ページは "article" */
  type?: "website" | "article";
  /** Keep the page out of search results (used by draft previews) */
  noindex?: boolean;
  /** Breadcrumb trail after "Home", for URLs whose segments do not map to pages (see Breadcrumb.astro) */
  breadcrumb?: { href: string; label: string }[];
  /** Show "Share on X" in the footer. Article pages have their own link under the body instead */
  share?: boolean;
  /** The page also has a Markdown version for AI agents (src/server/markdown.ts) */
  markdown?: boolean;
};

const siteName = "Nknight AMAMIYA@nk4dev";
const {
  title,
  description = "Nknight AMAMIYA (nk4dev) 's blog",
  type = "website",
  noindex = false,
  breadcrumb,
  share = true,
  markdown = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteName}` : siteName;
// 配信時は /blog → /blog/ へ転送されるので、og:url もスラッシュ付きに揃える
const pageURL = canonicalURL(Astro.url, Astro.site);
// Article bodies carry their own share link, and drafts should not be shared
const footerShare = share && type !== "article" && !noindex;
// 生成画像にはサイト名が入るので、ページ名（トップはサイト名）だけを渡す
const ogImage = `https://og-img.nknighta.me/?text=${encodeURIComponent(title ?? siteName)}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Pick the UI language before first paint: saved choice, otherwise the browser language
      (() => {
        let lang;
        try {
          lang = localStorage.getItem("lang");
        } catch {}
        if (lang !== "ja" && lang !== "en") {
          lang = navigator.language.toLowerCase().startsWith("ja")
            ? "ja"
            : "en";
        }
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Shared links carry UTM parameters; point search engines at the plain URL -->
    <link rel="canonical" href={pageURL} />
    {markdown && <link rel="alternate" type="text/markdown" href={new URL(markdownPath(pageURL.pathname), pageURL)} />}
    <!-- Google Search Console ownership check, carried over from the old nknighta.me -->
    <meta
      name="google-site-verification"
      content="FadhJDiAEFAdginv7Ttd1S3Ord4FWPtK3dnlKRAKeJo"
    />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nknight AMAMIYA (nk4dev) 's blog" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="nknighta.me" />
    <meta name="twitter:creator" content="@nk4dev" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@75..112.5,300..500&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />
    <Analytics enabled={!noindex} />
    <!-- Discovery for agents: the JSON API catalog (RFC 9727) -->
    <link rel="api-catalog" href="/.well-known/api-catalog" />
  </head>
  <body class="mx-auto flex min-h-dvh max-w-7xl flex-col px-4 py-8 sm:px-8 lg:px-12">
    <Loader />
    <!-- スマホ: 1 段目にロゴとリンク、2 段目にパンくず。sm 以上: 1 段にまとめる -->
    <!-- スマホ: 1 段目にロゴとメニューボタン、2 段目にパンくず。メニューは開いたときだけ帯の中に縦に並べる -->
    <header class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-t-md bg-[var(--brand)] px-4 py-3 font-bold text-white">
      <a
        href="/"
        aria-label={ui.ja["nav.home"]}
        {...i18nAttrs("nav.home", "aria-label")}
        class="shrink-0"
      >
        <Logo class="h-6 w-auto sm:h-7" />
      </a>
      <Breadcrumb
        current={title}
        trail={breadcrumb}
        class="order-last w-full text-sm sm:order-none sm:w-auto sm:min-w-0 sm:flex-1 sm:text-base"
      />
      <!-- Shows the language it switches to. Mobile: next to the menu button; sm and up: after the links -->
      <button
        id="lang-toggle"
        type="button"
        class="-my-1 ml-auto rounded border border-white/40 px-2 py-0.5 text-sm hover:bg-white/10 sm:order-1 sm:ml-0"
        aria-label={ui.ja["nav.lang"]}
        {...i18nAttrs("nav.lang", "aria-label")}
      >
        <span data-t="ja">EN</span>
        <span data-t="en">JA</span>
      </button>
      <button
        id="menu-toggle"
        type="button"
        class="group -my-1 rounded p-1.5 sm:hidden"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={ui.ja["nav.menu"]}
        {...i18nAttrs("nav.menu", "aria-label")}
      >
        <svg
          viewBox="0 0 24 24"
          class="size-6 group-aria-expanded:hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          class="hidden size-6 group-aria-expanded:block"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
      <!-- ページへのリンクと SNS を分ける。スマホは上下、sm 以上は縦線で左右に区切る -->
      <nav
        id="site-menu"
        aria-label="Site"
        class="hidden w-full sm:ml-auto sm:flex sm:w-auto sm:items-center"
      >
        <ul class="flex flex-col border-t border-white/25 pt-2 sm:flex-row sm:border-0 sm:pt-0">
          <li>
            <HeaderLink href="/blog/" class="py-2 sm:py-1">
              Blog
            </HeaderLink>
          </li>
          <li>
            <span
              aria-hidden="true"
              class="hidden px-1.5 py-1 opacity-60 sm:inline-block"
            >
              /
            </span>
            <HeaderLink href="/scraps/" class="py-2 sm:py-1">
              Scraps
            </HeaderLink>
          </li>
          <li>
            <span
              aria-hidden="true"
              class="hidden px-1.5 py-1 opacity-60 sm:inline-block"
            >
              /
            </span>
            <HeaderLink href="/apps/" class="py-2 sm:py-1">
              Apps
            </HeaderLink>
          </li>
          <li>
            <span
              aria-hidden="true"
              class="hidden px-1.5 py-1 opacity-60 sm:inline-block"
            >
              /
            </span>
            <HeaderLink href="/dev/" class="py-2 sm:py-1">
              Dev
            </HeaderLink>
          </li>
          <li>
            <span
              aria-hidden="true"
              class="hidden px-1.5 py-1 opacity-60 sm:inline-block"
            >
              /
            </span>
            <HeaderLink href="/about/" class="py-2 sm:py-1">
              About.me
            </HeaderLink>
          </li>
          <li>
            <span
              aria-hidden="true"
              class="hidden px-1.5 py-1 opacity-60 sm:inline-block"
            >
              /
            </span>
            <HeaderLink href="/social/" class="py-2 sm:py-1">
              Social
            </HeaderLink>
          </li>
        </ul>
        <span
          aria-hidden="true"
          class="mx-4 hidden h-5 w-px bg-white/40 sm:block"
        ></span>
        <ul
          aria-label="SNS"
          class="mt-2 flex gap-x-5 border-t border-white/25 pt-2 font-medium text-white/85 sm:mt-0 sm:gap-x-0 sm:border-0 sm:pt-0"
        >
          {
            // SNS は直リンクではなく /g/ や /x/ のリダイレクト（astro.config.mjs）を経由させる
            socialLinks.map(({ slug, label }, i) => (
              <li>
                {i > 0 && (
                  <span
                    aria-hidden="true"
                    class="hidden px-1.5 py-1 opacity-60 sm:inline-block"
                  >
                    /
                  </span>
                )}
                <HeaderLink
                  href={`/${slug}/`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="py-2 hover:text-white sm:py-1"
                >
                  {label}
                </HeaderLink>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main" class="w-full flex-1 py-10 sm:py-14">
      <slot />
    </main>
    <footer class="flex flex-wrap justify-between gap-2 border-t-4 border-[var(--brand)] pt-4 text-sm text-[var(--ink-soft)]">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>Nknight AMAMIYA@nk4dev</span>
        {footerShare && (
          <ShareX
            text={fullTitle}
            url={pageURL}
            placement="footer"
            class="hover:text-[var(--ink)]"
          />
        )}
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a
          href="/privacy/"
          class="hover:text-[var(--ink)] hover:underline underline-offset-4"
        >
          <T k="footer.privacy" />
        </a>
        <span>All rights reserved.</span>
      </div>
    </footer>
    <WebMCP />
    <script>
      // スマホのメニューの開閉。Esc で閉じてボタンにフォーカスを戻す
      const toggle = document.getElementById("menu-toggle")!;
      const menu = document.getElementById("site-menu")!;
      const setOpen = (open: boolean) => {
        toggle.setAttribute("aria-expanded", String(open));
        menu.classList.toggle("hidden", !open);
      };
      toggle.addEventListener("click", () =>
        setOpen(toggle.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          toggle.getAttribute("aria-expanded") === "true"
        ) {
          setOpen(false);
          toggle.focus();
        }
      });

      // Language switch. Text is swapped by CSS; attributes listed with data-i18n-* are swapped here
      const root = document.documentElement;
      const applyLang = (lang: "ja" | "en") => {
        root.dataset.lang = lang;
        root.lang = lang;
        document
          .querySelectorAll<HTMLElement>("[data-i18n-ja]")
          .forEach((el) => {
            const text =
              (lang === "en" ? el.dataset.i18nEn : el.dataset.i18nJa) ?? "";
            const attr = el.dataset.i18nAttr;
            if (attr) el.setAttribute(attr, text);
            else el.textContent = text;
          });
      };
      applyLang(root.dataset.lang === "en" ? "en" : "ja");
      document.getElementById("lang-toggle")!.addEventListener("click", () => {
        const next = root.dataset.lang === "en" ? "ja" : "en";
        applyLang(next);
        try {
          localStorage.setItem("lang", next);
        } catch {}
      });
    </script>
  </body>
</html>
