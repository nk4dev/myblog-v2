---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  ];
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>

  <!-- <body class="flex min-h-screen flex-col bg-white text-slate-900"> -->
  <body class={`flex min-h-screen flex-col`}> 

  <!-- header start -->
  <header class="border-b backdrop-blur">
     <script is:inline>
      const theme = (() => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") return saved;
        } catch {}
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      })();
      document.documentElement.dataset.theme = theme;
    </script>
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
    <a href="/" class="text-lg font-bold tracking-tight">
      nk4dev
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium">
      {
        navItems.map((item) => (
          <a href={item.href} class="transition-colors hover:text-slate-900 dark:hover:text-white">
            {item.label}
          </a>
        ))
      }
      <button id="theme-toggle" aria-label="テーマを切り替え">🌓</button>
    </nav>
  </div>
  </header>
  <!-- header end -->
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
  <script>
     document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
  </script>
    </html>

    
<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #111111;
  }
  :root[data-theme="dark"] {
    --bg: #111111;
    --fg: #eeeeee;
    color-scheme: dark;
  }
  body {
    background: var(--bg);
    color: var(--fg);
  }
  footer {

    background: var(--bg);
    color: var(--fg);
  }
</style>
