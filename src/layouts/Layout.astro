---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { i18nAttrs, ui } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// icon は 24x24 の SVG パス（stroke で描画）
const navItems = [
  {
    href: "/",
    label: "Home",
    icon: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" />',
  },
  {
    href: "/blog",
    label: "Blog",
    icon: '<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" />',
  },
  {
    href: "/scraps",
    label: "Scraps",
    icon: '<path d="M4 4h16v11l-5 5H4z" /><path d="M15 20v-5h5" />',
  },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>

  <!-- <body class="flex min-h-screen flex-col bg-white text-slate-900"> -->
  <body class={`flex min-h-screen flex-col`}> 

  <!-- header start -->
  <header class="dock-wrap">
     <script is:inline>
      const theme = (() => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") return saved;
        } catch {}
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      })();
      document.documentElement.dataset.theme = theme;

      // 表示言語: 保存済みの選択 → ブラウザの言語設定の順で決める
      const lang = (() => {
        try {
          const saved = localStorage.getItem("lang");
          if (saved === "ja" || saved === "en") return saved;
        } catch {}
        return navigator.language.toLowerCase().startsWith("ja") ? "ja" : "en";
      })();
      document.documentElement.dataset.lang = lang;
      document.documentElement.lang = lang;
    </script>
    <nav class="dock" aria-label="Main">
      <a href="/" class="dock-brand">nk4dev</a>
      <span class="dock-divider" aria-hidden="true"></span>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="dock-item"
            aria-label={item.label}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
            <span class="dock-label" aria-hidden="true">{item.label}</span>
          </a>
        ))
      }
      <span class="dock-divider" aria-hidden="true"></span>
      <button
        id="lang-toggle"
        class="dock-item dock-text"
        aria-label={ui.ja["nav.lang"]}
        {...i18nAttrs("nav.lang", "aria-label")}
      >
        <span data-t="ja">EN</span><span data-t="en">JA</span>
      </button>
      <button
        id="theme-toggle"
        class="dock-item"
        aria-label={ui.ja["nav.theme"]}
        {...i18nAttrs("nav.theme", "aria-label")}
      >
        <!-- ライト時は月、ダーク時は太陽（切り替え先）を表示 -->
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </nav>
  </header>
  <!-- header end -->
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 pt-28 pb-10">
      <slot />
    </main>
    <Footer />
  </body>
  <script>
     document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });

  const applyLang = (lang: "ja" | "en") => {
    const root = document.documentElement;
    root.dataset.lang = lang;
    root.lang = lang;
    // <T> で囲めない文字列・属性を差し替える（src/i18n/ui.ts の i18nAttrs）
    document.querySelectorAll<HTMLElement>("[data-i18n-ja]").forEach((el) => {
      const text = (lang === "en" ? el.dataset.i18nEn : el.dataset.i18nJa) ?? "";
      const attr = el.dataset.i18nAttr;
      if (attr) el.setAttribute(attr, text);
      else el.textContent = text;
    });
  };

  applyLang(document.documentElement.dataset.lang === "en" ? "en" : "ja");

  document.getElementById("lang-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.lang === "en" ? "ja" : "en";
    applyLang(next);
    try {
      localStorage.setItem("lang", next);
    } catch {}
  });
  </script>
    </html>

    
<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #111111;
  }
  :root[data-theme="dark"] {
    --bg: #111111;
    --fg: #eeeeee;
    color-scheme: dark;
  }
  body {
    background: var(--bg);
    color: var(--fg);
  }
  footer {

    background: var(--bg);
    color: var(--fg);
  }

  /* ---- Dock 風ヘッダー ---- */
  .dock-wrap {
    position: fixed;
    inset: 12px 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    pointer-events: none;
  }
  .dock {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
    box-shadow:
      0 10px 30px -10px rgb(0 0 0 / 0.35),
      inset 0 1px 0 color-mix(in srgb, #fff 15%, transparent);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
  }
  .dock-brand {
    padding: 0 8px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .dock-divider {
    width: 1px;
    height: 24px;
    margin: 0 4px;
    background: color-mix(in srgb, var(--fg) 15%, transparent);
  }
  .dock-item {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: inherit;
    transform-origin: top center;
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 150ms;
  }
  .dock-item svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dock-text {
    font-size: 0.8rem;
    font-weight: 600;
  }
  .dock-item:hover,
  .dock-item:focus-visible {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }
  /* ホバーした項目を拡大し、両隣も少し拡大する（macOS の Dock 風） */
  .dock-item:hover {
    transform: scale(1.3);
  }
  .dock-item:has(+ .dock-item:hover),
  .dock-item:hover + .dock-item {
    transform: scale(1.12);
  }
  /* 今いるページの目印（Dock の起動中インジケーター風） */
  .dock-item[aria-current="page"]::after {
    content: "";
    position: absolute;
    bottom: 1px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
  }
  .dock-label {
    position: absolute;
    top: calc(100% + 10px);
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.7rem;
    white-space: nowrap;
    color: var(--bg);
    background: var(--fg);
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 150ms,
      transform 150ms;
  }
  .dock-item:hover .dock-label,
  .dock-item:focus-visible .dock-label {
    opacity: 1;
    transform: none;
  }
  /* 拡大した項目の中でもラベルは等倍に見えるよう打ち消す */
  .dock-item:hover .dock-label {
    transform: scale(calc(1 / 1.3));
  }
  .icon-sun,
  :root[data-theme="dark"] .icon-moon {
    display: none;
  }
  :root[data-theme="dark"] .icon-sun {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .dock-item,
    .dock-label {
      transition: none;
    }
    .dock-item:hover,
    .dock-item:has(+ .dock-item:hover),
    .dock-item:hover + .dock-item {
      transform: none;
    }
  }
</style>
