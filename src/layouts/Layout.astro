---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { i18nAttrs, ui } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/scraps", label: "Scraps" },
  ];
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>

  <!-- <body class="flex min-h-screen flex-col bg-white text-slate-900"> -->
  <body class={`flex min-h-screen flex-col`}> 

  <!-- header start -->
  <header class="border-b backdrop-blur">
     <script is:inline>
      const theme = (() => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") return saved;
        } catch {}
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      })();
      document.documentElement.dataset.theme = theme;

      // 表示言語: 保存済みの選択 → ブラウザの言語設定の順で決める
      const lang = (() => {
        try {
          const saved = localStorage.getItem("lang");
          if (saved === "ja" || saved === "en") return saved;
        } catch {}
        return navigator.language.toLowerCase().startsWith("ja") ? "ja" : "en";
      })();
      document.documentElement.dataset.lang = lang;
      document.documentElement.lang = lang;
    </script>
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
    <a href="/" class="text-lg font-bold tracking-tight">
      nk4dev
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium">
      {
        navItems.map((item) => (
          <a href={item.href} class="transition-colors hover:text-slate-900 dark:hover:text-white">
            {item.label}
          </a>
        ))
      }
      <button
        id="lang-toggle"
        class="transition-colors hover:text-slate-900 dark:hover:text-white"
        aria-label={ui.ja["nav.lang"]}
        {...i18nAttrs("nav.lang", "aria-label")}
      >
        <span data-t="ja">EN</span><span data-t="en">JA</span>
      </button>
      <button id="theme-toggle" aria-label={ui.ja["nav.theme"]} {...i18nAttrs("nav.theme", "aria-label")}>🌓</button>
    </nav>
  </div>
  </header>
  <!-- header end -->
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
  <script>
     document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });

  const applyLang = (lang: "ja" | "en") => {
    const root = document.documentElement;
    root.dataset.lang = lang;
    root.lang = lang;
    // <T> で囲めない文字列・属性を差し替える（src/i18n/ui.ts の i18nAttrs）
    document.querySelectorAll<HTMLElement>("[data-i18n-ja]").forEach((el) => {
      const text = (lang === "en" ? el.dataset.i18nEn : el.dataset.i18nJa) ?? "";
      const attr = el.dataset.i18nAttr;
      if (attr) el.setAttribute(attr, text);
      else el.textContent = text;
    });
  };

  applyLang(document.documentElement.dataset.lang === "en" ? "en" : "ja");

  document.getElementById("lang-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.lang === "en" ? "ja" : "en";
    applyLang(next);
    try {
      localStorage.setItem("lang", next);
    } catch {}
  });
  </script>
    </html>

    
<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #111111;
  }
  :root[data-theme="dark"] {
    --bg: #111111;
    --fg: #eeeeee;
    color-scheme: dark;
  }
  body {
    background: var(--bg);
    color: var(--fg);
  }
  footer {

    background: var(--bg);
    color: var(--fg);
  }
</style>
