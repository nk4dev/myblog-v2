---
import "../styles/global.css";
import type { ComponentProps } from "astro/types";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { i18nAttrs, ui } from "../i18n/ui";

type Props = ComponentProps<typeof BaseHead>;

const headProps = Astro.props;

// icon は 24x24 の SVG パス（stroke で描画）
const navItems = [
  {
    href: "/",
    label: "Home",
    icon: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" />',
  },
  {
    href: "/blog/",
    label: "Blog",
    icon: '<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" />',
  },
  {
    href: "/scraps/",
    label: "Scraps",
    icon: '<path d="M4 4h16v11l-5 5H4z" /><path d="M15 20v-5h5" />',
  },
];

// リンクはスラッシュ付き（/blog/）なので、現在地もスラッシュ付きにして比べる
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

// 図面枠の区域記号（横は数字、縦はアルファベット）
const zonesX = ["1", "2", "3", "4", "5", "6", "7", "8"];
const zonesY = ["A", "B", "C", "D", "E", "F"];
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead {...headProps} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@75..112.5,300..500&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />
    <script is:inline>
      // 描画前にテーマと表示言語を決めてチラつきを防ぐ
      const root = document.documentElement;
      root.dataset.theme = (() => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") return saved;
        } catch {}
        return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      })();
      // 表示言語: 保存済みの選択 → ブラウザの言語設定の順で決める
      const lang = (() => {
        try {
          const saved = localStorage.getItem("lang");
          if (saved === "ja" || saved === "en") return saved;
        } catch {}
        return navigator.language.toLowerCase().startsWith("ja") ? "ja" : "en";
      })();
      root.dataset.lang = lang;
      root.lang = lang;
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- 図面枠: 定規・区域記号・カーソル位置。装飾なので支援技術からは隠す -->
    <div class="sheet" aria-hidden="true">
      <div class="sheet-ruler sheet-ruler-x">
        {zonesX.map((z) => <span>{z}</span>)}
        <i class="sheet-cursor-x"></i>
      </div>
      <div class="sheet-ruler sheet-ruler-y">
        {zonesY.map((z) => <span>{z}</span>)}
        <i class="sheet-cursor-y"></i>
      </div>
      <div class="sheet-readout"><span id="readout-x">x 0000</span><span id="readout-y">y 0000</span></div>
      <div class="sheet-progress" id="sheet-progress"></div>
    </div>

    <header class="dock-wrap">
      <nav class="dock bp" data-bp="nav" aria-label="Main">
        <a href="/" class="dock-brand">nk4dev</a>
        <span class="dock-divider" aria-hidden="true"></span>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="dock-item"
              aria-label={item.label}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
              <span class="dock-label" aria-hidden="true">{item.label}</span>
            </a>
          ))
        }
        <span class="dock-divider" aria-hidden="true"></span>
        <button
          id="lang-toggle"
          class="dock-item dock-text"
          aria-label={ui.ja["nav.lang"]}
          {...i18nAttrs("nav.lang", "aria-label")}
        >
          <span data-t="ja">EN</span><span data-t="en">JA</span>
        </button>
        <button
          id="theme-toggle"
          class="dock-item"
          aria-label={ui.ja["nav.theme"]}
          {...i18nAttrs("nav.theme", "aria-label")}
        >
          <!-- ライト時は月、ダーク時は太陽（切り替え先）を表示 -->
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main id="main" class="relative mx-auto w-full max-w-6xl flex-1 px-5 pt-32 pb-16 sm:px-10 lg:px-14">
      <slot />
    </main>
    <Footer title={headProps.title} />

    <script>
      const root = document.documentElement;

      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        const apply = () => {
          root.dataset.theme = next;
        };
        // 対応ブラウザでは、紙が焼き替わるように左上から円形に切り替える
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (document.startViewTransition && !reduce) {
          root.classList.add("theme-swap");
          document.startViewTransition(apply).finished.finally(() => root.classList.remove("theme-swap"));
        } else {
          apply();
        }
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });

      const applyLang = (lang: "ja" | "en") => {
        root.dataset.lang = lang;
        root.lang = lang;
        // <T> で囲めない文字列・属性を差し替える（src/i18n/ui.ts の i18nAttrs）
        document.querySelectorAll<HTMLElement>("[data-i18n-ja]").forEach((el) => {
          const text = (lang === "en" ? el.dataset.i18nEn : el.dataset.i18nJa) ?? "";
          const attr = el.dataset.i18nAttr;
          if (attr) el.setAttribute(attr, text);
          else el.textContent = text;
        });
      };

      applyLang(root.dataset.lang === "en" ? "en" : "ja");

      document.getElementById("lang-toggle")?.addEventListener("click", () => {
        const next = root.dataset.lang === "en" ? "ja" : "en";
        applyLang(next);
        try {
          localStorage.setItem("lang", next);
        } catch {}
      });

      // 定規上のカーソル位置（マウス操作の端末だけ）
      if (matchMedia("(pointer: fine)").matches) {
        const sheet = document.querySelector<HTMLElement>(".sheet")!;
        const rx = document.getElementById("readout-x")!;
        const ry = document.getElementById("readout-y")!;
        let frame = 0;
        let x = 0;
        let y = 0;
        addEventListener(
          "pointermove",
          (e) => {
            x = e.clientX;
            y = e.clientY;
            if (frame) return;
            frame = requestAnimationFrame(() => {
              frame = 0;
              // :root に置くとページ全体のスタイル再計算になるので、図面枠の中だけで完結させる
              sheet.style.setProperty("--cx", `${x}px`);
              sheet.style.setProperty("--cy", `${y}px`);
              rx.textContent = `x ${String(Math.round(x)).padStart(4, "0")}`;
              ry.textContent = `y ${String(Math.round(y + scrollY)).padStart(4, "0")}`;
            });
          },
          { passive: true },
        );
        root.classList.add("has-cursor");
      }

      // 上辺の赤線でスクロール位置を示す。scroll-driven animation 非対応のブラウザだけ JS で動かす
      if (!CSS.supports("animation-timeline: scroll()")) {
        const progress = document.getElementById("sheet-progress");
        let max = 0;
        let queued = false;
        const measureMax = () => {
          max = document.documentElement.scrollHeight - innerHeight;
        };
        const update = () => {
          queued = false;
          progress?.style.setProperty("--p", String(max > 0 ? scrollY / max : 0));
        };
        measureMax();
        update();
        addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
        addEventListener("resize", () => {
          measureMax();
          update();
        });
        new ResizeObserver(measureMax).observe(document.body);
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }

  /* ---- 図面枠 ---- */
  .sheet {
    --inset: 8px;
    --ruler: 0px;
    position: fixed;
    inset: var(--inset);
    z-index: 40;
    pointer-events: none;
    border: 1px solid var(--line);
    view-transition-name: sheet;
    contain: strict;
  }
  .sheet-ruler,
  .sheet-readout {
    display: none;
  }
  .sheet-progress {
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background: var(--red);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  /* 対応ブラウザでは JS を使わず、スクロール位置だけで（合成スレッドで）伸ばす */
  @supports (animation-timeline: scroll()) {
    .sheet-progress {
      animation: progress linear both;
      animation-timeline: scroll(root block);
    }
    @keyframes progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }
  @media (min-width: 768px) {
    .sheet {
      --inset: 12px;
      --ruler: 18px;
    }
    .sheet-ruler {
      position: absolute;
      display: flex;
      color: var(--line-strong);
      font: 400 9px/1 var(--font-mono);
      --tick: var(--line);
    }
    .sheet-ruler span {
      flex: 1;
      display: grid;
      place-items: center;
    }
    .sheet-ruler-x {
      top: 0;
      left: var(--ruler);
      right: 0;
      height: var(--ruler);
      border-bottom: 1px solid var(--line);
      background:
        repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 8px) left bottom / 100% 4px no-repeat,
        repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 40px) left bottom / 100% 8px no-repeat;
    }
    .sheet-ruler-x span + span {
      border-left: 1px solid var(--line);
    }
    .sheet-ruler-y {
      top: var(--ruler);
      left: 0;
      bottom: 0;
      width: var(--ruler);
      flex-direction: column;
      border-right: 1px solid var(--line);
      background:
        repeating-linear-gradient(var(--tick) 0 1px, transparent 1px 8px) right top / 4px 100% no-repeat,
        repeating-linear-gradient(var(--tick) 0 1px, transparent 1px 40px) right top / 8px 100% no-repeat;
    }
    .sheet-ruler-y span + span {
      border-top: 1px solid var(--line);
    }
    .sheet-ruler i {
      position: absolute;
      display: none;
      background: var(--red);
    }
    .has-cursor .sheet-ruler i {
      display: block;
    }
    .sheet-cursor-x {
      bottom: -1px;
      left: 0;
      width: 1px;
      height: 100%;
      transform: translateX(calc(var(--cx, -100px) - var(--inset) - var(--ruler) - 1px));
    }
    .sheet-cursor-y {
      right: -1px;
      top: 0;
      width: 100%;
      height: 1px;
      transform: translateY(calc(var(--cy, -100px) - var(--inset) - var(--ruler) - 1px));
    }
    .has-cursor .sheet-readout {
      position: absolute;
      left: calc(var(--ruler) + 8px);
      bottom: 8px;
      display: flex;
      gap: 10px;
      padding: 3px 6px;
      font: 400 9px/1.4 var(--font-mono);
      color: var(--line-strong);
      background: var(--paper);
      border: 1px solid var(--line);
      font-variant-numeric: tabular-nums;
    }
  }

  /* テーマ切り替え: 新しい紙が左上から焼き付くように広がる */
  .theme-swap::view-transition-old(root),
  .theme-swap::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  .theme-swap::view-transition-new(root) {
    animation: sheet-burn 700ms cubic-bezier(0.6, 0, 0.2, 1);
  }
  @keyframes sheet-burn {
    from {
      clip-path: circle(0 at 0 0);
    }
    to {
      clip-path: circle(150% at 0 0);
    }
  }

  /* ---- Dock 風ヘッダー ---- */
  .dock-wrap {
    position: fixed;
    inset: 22px 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    pointer-events: none;
    view-transition-name: dock;
  }
  @media (min-width: 768px) {
    .dock-wrap {
      inset: 40px 0 auto;
    }
  }
  .dock {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 5px 8px;
    /* backdrop-filter はスクロールのたびに背面を描き直して重いので、不透明に近い紙色で塗る */
    background: color-mix(in srgb, var(--paper) 94%, transparent);
  }
  .dock-brand {
    padding: 0 10px 0 6px;
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  .dock-divider {
    width: 1px;
    height: 24px;
    margin: 0 4px;
    background: var(--line);
  }
  .dock-item {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: inherit;
    cursor: pointer;
    transform-origin: top center;
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 150ms;
  }
  .dock-item svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dock-text {
    font: 500 0.6875rem/1 var(--font-mono);
  }
  .dock-item:hover,
  .dock-item:focus-visible {
    background: var(--grid-major);
    outline: 1px dashed var(--line-strong);
    outline-offset: -1px;
  }
  /* ホバーした項目を拡大し、両隣も少し拡大する（macOS の Dock 風） */
  .dock-item:hover {
    transform: scale(1.3);
  }
  .dock-item:has(+ .dock-item:hover),
  .dock-item:hover + .dock-item {
    transform: scale(1.12);
  }
  /* 今いるページの目印（赤入れ） */
  .dock-item[aria-current="page"]::after {
    content: "";
    position: absolute;
    bottom: 2px;
    width: 4px;
    height: 4px;
    background: var(--red);
  }
  .dock-label {
    position: absolute;
    top: calc(100% + 10px);
    padding: 2px 8px;
    font: 400 10px/1.6 var(--font-mono);
    white-space: nowrap;
    color: var(--paper);
    background: var(--ink);
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 150ms,
      transform 150ms;
  }
  .dock-item:hover .dock-label,
  .dock-item:focus-visible .dock-label {
    opacity: 1;
    transform: none;
  }
  /* 拡大した項目の中でもラベルは等倍に見えるよう打ち消す */
  .dock-item:hover .dock-label {
    transform: scale(calc(1 / 1.3));
  }
  .icon-sun,
  :root[data-theme="dark"] .icon-moon {
    display: none;
  }
  :root[data-theme="dark"] .icon-sun {
    display: block;
  }
  @media (max-width: 420px) {
    .dock-brand {
      display: none;
    }
    .dock-brand + .dock-divider {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dock-item,
    .dock-label {
      transition: none;
    }
    .dock-item:hover,
    .dock-item:has(+ .dock-item:hover),
    .dock-item:hover + .dock-item {
      transform: none;
    }
  }
</style>
