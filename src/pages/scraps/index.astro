---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import { getAllScraps } from "../../lib/microcms";

const scraps = await getAllScraps();
---

<Layout title="Scraps" description="ちょっとしたメモやつぶやきをまとめたスクラップ一覧です。">
  <h1 class="mb-10 text-4xl font-extrabold">Scraps</h1>
  {
    scraps.length > 0 ? (
      <PostList posts={scraps} basePath="/scraps" />
    ) : (
      <p class="text-[var(--ink-soft)]">Nothing here.</p>
    )
  }
</Layout>
