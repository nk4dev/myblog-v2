---
import Layout from "../../layouts/Layout.astro";
import { getAllScraps, getScrapDetail } from "../../lib/microcms";
import T from "../../components/T.astro";

export async function getStaticPaths() {
  const scraps = await getAllScraps();
  return scraps.map((scrap) => ({
    params: { id: scrap.id },
  }));
}

const { id } = Astro.params;
const scrap = await getScrapDetail(id!);

if (!scrap) {
  return Astro.redirect("/404");
}

const publishedDate = new Date(scrap.publishedAt ?? scrap.createdAt).toLocaleDateString("ja-JP");
---

<Layout title={`${scrap.title} | Nknight AMAMIYA@nk4dev`} description={scrap.title}>
  <article lang="ja">
    <div class="mb-2 flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
      <time datetime={scrap.publishedAt ?? scrap.createdAt}>{publishedDate}</time>
      {scrap.category && (
        <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 font-medium text-slate-600 dark:text-slate-400">
          {scrap.category}
        </span>
      )}
    </div>
    <h1 class="mb-6 text-2xl font-bold text-slate-900 dark:text-slate-100">{scrap.title}</h1>
    <div class="prose prose-slate dark:prose-invert max-w-none" set:html={scrap.content} />
  </article>
  <a href="/scraps" class="mt-10 inline-block text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
    &larr; <T k="scraps.back" />
  </a>
</Layout>
