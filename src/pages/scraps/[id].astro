---
import Layout from "../../layouts/Layout.astro";
import Article from "../../components/Article.astro";
import { getScrapDetail } from "../../lib/microcms";
import { excerpt } from "../../lib/excerpt";

// Rendered on demand so content changes in microCMS show up without a rebuild
export const prerender = false;

const { id } = Astro.params;
const scrap = await getScrapDetail(id!);

if (!scrap) {
  return new Response(null, { status: 404 });
}
---

<Layout markdown type="article" title={scrap.title} description={excerpt(scrap.content) || scrap.title}>
  <Article
    title={scrap.title}
    content={scrap.content}
    publishedAt={scrap.publishedAt ?? scrap.createdAt}
    revisedAt={scrap.revisedAt}
    category={scrap.category}
    back={{ href: "/scraps/", label: "scraps.back" }}
  />
</Layout>
