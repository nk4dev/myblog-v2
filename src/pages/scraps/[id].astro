---
import Layout from "../../layouts/Layout.astro";
import Article from "../../components/Article.astro";
import { getAllScraps, getScrapDetail } from "../../lib/microcms";
import { excerpt } from "../../lib/excerpt";

export async function getStaticPaths() {
  const scraps = await getAllScraps();
  return scraps.map((scrap) => ({
    params: { id: scrap.id },
  }));
}

const { id } = Astro.params;
const scrap = await getScrapDetail(id!);

if (!scrap) {
  return Astro.redirect("/404");
}
---

<Layout
  title={scrap.title}
  description={excerpt(scrap.content) || scrap.title}
  type="article"
  publishedTime={scrap.publishedAt ?? scrap.createdAt}
  modifiedTime={scrap.revisedAt}
>
  <Article
    kind="scrap"
    title={scrap.title}
    content={scrap.content}
    publishedAt={scrap.publishedAt ?? scrap.createdAt}
    revisedAt={scrap.revisedAt}
    category={scrap.category}
    back={{ href: "/scraps", label: "scraps.back" }}
  />
</Layout>
