---
import Layout from "../layouts/Layout.astro";
import T from "../components/T.astro";
---

<Layout title="404 Not Found | Nknight AMAMIYA@nk4dev" description="ページが見つかりませんでした。">
  <div class="py-20 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">404</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400"><T k="404.message" /></p>
    <a href="/" class="mt-6 inline-block text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
      &larr; <T k="404.back" />
    </a>
  </div>
</Layout>
