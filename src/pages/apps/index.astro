---
import Layout from "../../layouts/Layout.astro";
import T from "../../components/T.astro";
import { apps } from "../../data/apps";
---

<Layout title="Apps" description="Nknight AMAMIYA (nk4dev) がつくった小さな Web アプリの一覧です。">
  <div class="grid grid-cols-1 gap-x-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]">
    <div class="mb-10 lg:sticky lg:top-8 lg:self-start">
      <h1 class="text-4xl font-extrabold lg:text-5xl">Apps</h1>
      <p class="tabular mt-2 text-[var(--ink-soft)]">{apps.length} <T k="list.count" /></p>
    </div>
    <ul class="grid gap-10 sm:grid-cols-2">
      {
        apps.map((app) => (
          <li class="flex flex-col">
            <a href={app.href} class="group block">
              {app.image ? (
                <img
                  src={app.image.src}
                  alt=""
                  width={app.image.width}
                  height={app.image.height}
                  loading="lazy"
                  class="aspect-[5/3] w-full rounded-md object-cover transition-opacity group-hover:opacity-85"
                />
              ) : (
                // No screenshot: show the app name on a brand-colored panel instead
                <div
                  aria-hidden="true"
                  class="grid aspect-[5/3] w-full place-items-center rounded-md bg-[var(--brand)] text-3xl font-extrabold text-white transition-opacity [font-stretch:125%] group-hover:opacity-85"
                >
                  {app.name}
                </div>
              )}
              <h2 class="mt-4 text-2xl font-bold">
                <span class="mark">{app.name}</span>
              </h2>
            </a>
            <p class="mt-2 text-[var(--ink-soft)]">
              <T text={app.desc} />
            </p>
            {app.links && (
              <ul class="mt-3 flex flex-wrap gap-x-5 text-sm">
                {app.links.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="mark font-medium text-[var(--link)]">
                      <T text={link.label} /> ↗
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
