---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import T from "../../components/T.astro";
import { apps } from "../../data/apps";
import { getAllBlogs, getAllProjects } from "../../lib/microcms";
import { categoryPath } from "../../lib/blog-pages";
import {
  findRelatedBlogForApp,
  getFeaturedPosts,
  getProjectExternalLink,
} from "../../lib/related-posts";

// Rendered on demand so links to microCMS blog guides and dev projects stay current
export const prerender = false;

const [allBlogs, allProjects] = await Promise.all([
  getAllBlogs().catch(() => []),
  getAllProjects().catch(() => []),
]);

const featuredBlogs = getFeaturedPosts(allBlogs, 3);
const highlightedProjects = allProjects.slice(0, 6);
---

<Layout
  title="Apps"
  description="Nknight AMAMIYA (nk4dev) がつくった Web アプリ（YTImage-dl・Grove Player）と、VRCBrowser などの開発プロジェクト・関連ブログ記事の一覧です。"
  metaKeywords="YTImage-dl, Grove Player, VRCBrowser, Webアプリ, VRChat"
>
  <div class="grid grid-cols-1 gap-x-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]">
    <div class="mb-10 lg:sticky lg:top-8 lg:self-start">
      <h1 class="text-4xl font-extrabold lg:text-5xl">Apps</h1>
      <p class="tabular mt-2 text-[var(--ink-soft)]">{apps.length} <T k="list.count" /></p>
    </div>
    <div>
      <ul class="grid gap-10 sm:grid-cols-2">
        {
          apps.map((app) => {
            const matchedBlog =
              (app.blogSlug ? allBlogs.find((b) => b.id === app.blogSlug) : undefined) ??
              findRelatedBlogForApp(app.name, allBlogs, app.aliases);
            const hasLinks = Boolean((app.links && app.links.length > 0) || app.docsUrl || matchedBlog);
            return (
              <li class="flex flex-col">
                <a href={app.href} class="group block">
                  {app.image ? (
                    <img
                      src={app.image.src}
                      alt=""
                      width={app.image.width}
                      height={app.image.height}
                      loading="lazy"
                      class="aspect-[5/3] w-full rounded-md object-cover transition-opacity group-hover:opacity-85"
                    />
                  ) : (
                    // No screenshot: show the app name on a brand-colored panel instead
                    <div
                      aria-hidden="true"
                      class="grid aspect-[5/3] w-full place-items-center rounded-md bg-[var(--brand)] text-3xl font-extrabold text-white transition-opacity [font-stretch:125%] group-hover:opacity-85"
                    >
                      {app.name}
                    </div>
                  )}
                  <h2 class="mt-4 text-2xl font-bold">
                    <span class="mark">{app.name}</span>
                  </h2>
                </a>
                <p class="mt-2 text-[var(--ink-soft)]">
                  <T text={app.desc} />
                </p>
                {hasLinks && (
                  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                    {app.links?.map((link) => (
                      <li>
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="mark font-medium text-[var(--link)]">
                          <T text={link.label} /> ↗
                        </a>
                      </li>
                    ))}
                    {app.docsUrl && (
                      <li>
                        <a href={app.docsUrl} target="_blank" rel="noopener noreferrer" class="mark font-medium text-[var(--link)]">
                          Docs ↗
                        </a>
                      </li>
                    )}
                    {matchedBlog && (
                      <li>
                        <a href={`/blog/${matchedBlog.id}/`} class="mark font-medium text-[var(--link)]">
                          <T text={{ ja: "解説記事", en: "Guide" }} />
                        </a>
                      </li>
                    )}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>

      {(highlightedProjects.length > 0 || featuredBlogs.length > 0) && (
        <div class="mt-14 space-y-12 border-t border-[var(--ink-soft)]/25 pt-10">
          {highlightedProjects.length > 0 && (
            <section>
              <h2 class="mb-5 text-2xl font-bold">
                <T text={{ ja: "開発プロジェクト", en: "Dev projects" }} />
              </h2>
              <ul class="grid gap-4 sm:grid-cols-2">
                {highlightedProjects.map((project) => {
                  const externalLink = getProjectExternalLink(project, Astro.site);
                  const matched = findRelatedBlogForApp(project.id, allBlogs, [project.name]);
                  return (
                    <li class="rounded-md border border-[var(--ink-soft)]/25 p-4">
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <a href={`/dev/${project.id}/`} class="mark font-bold text-[var(--link)]">
                          {project.name}
                        </a>
                        {project.category && (
                          <span class="text-xs text-[var(--ink-soft)]">{project.category}</span>
                        )}
                      </div>
                      {(externalLink || matched) && (
                        <ul class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                          {matched && (
                            <li>
                              <a href={`/blog/${matched.id}/`} class="mark font-medium text-[var(--link)]">
                                <T text={{ ja: "解説記事", en: "Guide" }} />
                              </a>
                            </li>
                          )}
                          {externalLink && (
                            <li>
                              <a href={externalLink.url} target="_blank" rel="noopener noreferrer" class="mark font-medium text-[var(--link)]">
                                {externalLink.label}
                              </a>
                            </li>
                          )}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
              <a href="/dev/" class="mark mt-6 inline-block font-medium text-[var(--link)]">
                <T text={{ ja: "すべてのプロジェクト", en: "All projects" }} />
              </a>
            </section>
          )}

          {featuredBlogs.length > 0 && (
            <section>
              <h2 class="mb-5 text-2xl font-bold">
                <T text={{ ja: "関連する記事", en: "Related posts" }} />
              </h2>
              <PostList
                posts={featuredBlogs.map((post) => ({
                  ...post,
                  category: post.category?.name,
                  categoryHref: post.category && categoryPath(post.category.id),
                }))}
                basePath="/blog"
              />
              <a href="/blog/" class="mark mt-6 inline-block font-medium text-[var(--link)]">
                <T text={{ ja: "すべての記事", en: "All posts" }} />
              </a>
            </section>
          )}
        </div>
      )}
    </div>
  </div>
</Layout>
