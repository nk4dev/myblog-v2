---
import Layout from "../../layouts/Layout.astro";
import { getAllBlogs } from "../../lib/microcms";

const posts = await getAllBlogs();
---

<Layout>
<div>
  {
    posts.length > 0 ? (
      <ol id="post-list" class="entries">
        {posts.map((post) => (
        <div>
          <p>{post.title}</p>
          </div>
        ))}
      </ol>
    ) : (
      <p class="text-[var(--ink-soft)]">
        まだ何も書いていません。
      </p>
    )
}

</div>
</Layout>
