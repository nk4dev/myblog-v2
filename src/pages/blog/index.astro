---
import Layout from "../../layouts/Layout.astro";
import BlogList from "../../components/BlogList.astro";
import { getAllBlogs } from "../../lib/microcms";
import { collectCategories, toPages } from "../../lib/blog-pages";

// Page 1 of the list; later pages are blog/page/[page].astro
const posts = await getAllBlogs();
const pages = toPages(posts);
---

<Layout title="Blog" description="Nknight AMAMIYA (nk4dev) のブログ記事一覧です。">
  <BlogList
    heading="Blog"
    posts={pages[0]}
    total={posts.length}
    categories={collectCategories(posts)}
    base="/blog"
    page={1}
    lastPage={pages.length}
  />
</Layout>
