---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import { getAllBlogs } from "../../lib/microcms";

const posts = await getAllBlogs();
---

<Layout>
  <h1 class="mb-10 text-4xl font-extrabold">Blog</h1>
  {
    posts.length > 0 ? (
      <PostList posts={posts.map((post) => ({ ...post, category: post.category?.name }))} basePath="/blog" />
    ) : (
      <p class="text-[var(--ink-soft)]">Nothing here.</p>
    )
  }
</Layout>
