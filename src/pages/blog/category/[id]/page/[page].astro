---
import Layout from "../../../../../layouts/Layout.astro";
import BlogList from "../../../../../components/BlogList.astro";
import { getAllBlogs } from "../../../../../lib/microcms";
import { categoryPath, collectCategories, toPages } from "../../../../../lib/blog-pages";

// Pages 2 and later of a category's posts. Page 1 lives at /blog/category/[id]/
// Rendered on demand so content changes in microCMS show up without a rebuild
export const prerender = false;

// Only canonical numbers from 2 up: page 1 has its own URL and "02" would duplicate page 2
const page = Number(Astro.params.page);
const allPosts = await getAllBlogs();
const categories = collectCategories(allPosts);
const category = categories.find((c) => c.category.id === Astro.params.id)?.category;
if (!category) {
  return new Response(null, { status: 404 });
}

const inCategory = allPosts.filter((post) => post.category?.id === category.id);
const pages = toPages(inCategory);
if (String(page) !== Astro.params.page || page < 2 || page > pages.length) {
  return new Response(null, { status: 404 });
}

const posts = pages[page - 1];
const total = inCategory.length;
const lastPage = pages.length;
---

<Layout
  title={`${category.name} - Blog - Page ${page}`}
  description={`Nknight AMAMIYA (nk4dev) のブログの「${category.name}」の記事一覧（${page} ページ目）です。`}
  breadcrumb={[
    { href: "/blog/", label: "Blog" },
    { href: categoryPath(category.id), label: category.name },
    { href: Astro.url.pathname, label: `Page ${page}` },
  ]}
>
  <BlogList
    heading={category.name}
    posts={posts}
    total={total}
    categories={categories}
    activeCategory={category.id}
    base={categoryPath(category.id).slice(0, -1)}
    page={page}
    lastPage={lastPage}
  />
</Layout>
