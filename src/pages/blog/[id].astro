---
import Layout from "../../layouts/Layout.astro";
import Article from "../../components/Article.astro";
import { getBlogDetail } from "../../lib/microcms";
import { excerpt } from "../../lib/excerpt";
import { categoryPath } from "../../lib/blog-pages";

// Rendered on demand so content changes in microCMS show up without a rebuild
export const prerender = false;

const { id } = Astro.params;
const post = await getBlogDetail(id!);

if (!post) {
  return new Response(null, { status: 404 });
}
---

<Layout markdown type="article" title={post.title} description={post.description || excerpt(post.content)}>
  <Article
    title={post.title}
    content={post.content}
    publishedAt={post.publishedAt ?? post.createdAt}
    revisedAt={post.revisedAt}
    category={post.category?.name}
    categoryHref={post.category && categoryPath(post.category.id)}
    eyecatch={post.eyecatch}
    back={{ href: "/blog/", label: "blog.back" }}
  />
</Layout>
