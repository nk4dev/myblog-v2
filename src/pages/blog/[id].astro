---
import Layout from "../../layouts/Layout.astro";
import { getBlogs, getBlogDetail } from "../../lib/microcms";

export async function getStaticPaths() {
  const { contents: posts } = await getBlogs();
  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const { id } = Astro.params;
const post = await getBlogDetail(id!);

if (!post) {
  return Astro.redirect("/404");
}

const publishedDate = new Date(post.publishedAt ?? post.createdAt).toLocaleDateString("ja-JP");
---

<Layout title={`${post.title} | Nknight AMAMIYA@nk4dev`} description={post.description}>
  <article>
    <div class="mb-2 flex items-center gap-3 text-xs text-slate-500">
      <time datetime={post.publishedAt ?? post.createdAt}>{publishedDate}</time>
      {post.category && (
        <span class="rounded-full bg-slate-100 px-2 py-0.5 font-medium text-slate-600">
          {post.category.name}
        </span>
      )}
    </div>
    <h1 class="mb-6 text-2xl font-bold text-slate-900">{post.title}</h1>
    <div class="prose prose-slate max-w-none" set:html={post.content} />
  </article>
  <a href="/blog" class="mt-10 inline-block text-sm font-medium text-slate-500 hover:text-slate-900">
    &larr; 記事一覧に戻る
  </a>
</Layout>
