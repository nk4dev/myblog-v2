---
import Layout from "../../layouts/Layout.astro";
import Article from "../../components/Article.astro";
import { getAllBlogs, getBlogDetail } from "../../lib/microcms";
import { excerpt } from "../../lib/excerpt";

export async function getStaticPaths() {
  const posts = await getAllBlogs();
  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const { id } = Astro.params;
const post = await getBlogDetail(id!);

if (!post) {
  return Astro.redirect("/404");
}
---

<Layout
  title={post.title}
  description={post.description || excerpt(post.content)}
  image={post.eyecatch?.url}
  imageWidth={post.eyecatch?.width}
  imageHeight={post.eyecatch?.height}
  type="article"
  publishedTime={post.publishedAt ?? post.createdAt}
  modifiedTime={post.revisedAt}
>
  <Article
    kind="article"
    title={post.title}
    content={post.content}
    publishedAt={post.publishedAt ?? post.createdAt}
    revisedAt={post.revisedAt}
    category={post.category?.name}
    eyecatch={post.eyecatch}
    back={{ href: "/blog/", label: "blog.back" }}
  />
</Layout>
