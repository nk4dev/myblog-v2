---
import Layout from "../../layouts/Layout.astro";
import { getAllBlogs, getBlogDetail } from "../../lib/microcms";
import T from "../../components/T.astro";

export async function getStaticPaths() {
  const posts = await getAllBlogs();
  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const { id } = Astro.params;
const post = await getBlogDetail(id!);

if (!post) {
  return Astro.redirect("/404");
}

const publishedDate = new Date(post.publishedAt ?? post.createdAt).toLocaleDateString("ja-JP");
---

<Layout title={`${post.title} | Nknight AMAMIYA@nk4dev`} description={post.description}>
  <article lang="ja" class="bp p-6" data-bp="article">
    <div class="mb-2 flex items-center gap-3 font-mono text-xs text-slate-500 dark:text-slate-400">
      <time datetime={post.publishedAt ?? post.createdAt}>{publishedDate}</time>
      {post.category && (
        <span class="bp-tag px-2 py-0.5 font-medium text-slate-600 dark:text-slate-400">
          {post.category.name}
        </span>
      )}
    </div>
    <h1 class="mb-6 text-2xl font-bold text-slate-900 dark:text-slate-100">{post.title}</h1>
    <div class="prose prose-slate dark:prose-invert max-w-none" set:html={post.content} />
  </article>
  <a href="/blog" class="mt-10 inline-block text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
    &larr; <T k="blog.back" />
  </a>
</Layout>
