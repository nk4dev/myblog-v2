---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { getAllBlogs } from "../lib/microcms";
import T from "../components/T.astro";

const posts = (await getAllBlogs()).slice(0, 3);
---

<Layout
  title="Nknight AMAMIYA@nk4dev | Personal Site"
  description="Nknight AMAMIYA (nk4dev) の個人サイト兼ブログです。"
>
  <section class="bp mb-12 p-6" data-bp="profile">
    <h1 class="text-3xl font-bold tracking-tight">
      Nknight AMAMIYA@nk4dev
    </h1>
    <p class="mt-4">
      <T k="home.bio1" />
      <br/>
      <T k="home.bio2" />
    </p>
    <!--
    {isMockMode && (
      <p class="mt-4 rounded-md bg-amber-50 px-4 py-2 text-sm text-amber-700">
        現在モックデータで表示中です。<code>.env</code> に
        <code>MICROCMS_SERVICE_DOMAIN</code> / <code>MICROCMS_API_KEY</code>
        を設定すると実データに切り替わります。
      </p>
      )}
      -->
  </section>

  <section class="bp p-6" data-bp="latest-posts">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-semibold">Latest Posts</h2>
      <a href="/blog" class="text-sm font-medium hover:text-slate-900 dark:hover:text-white">
        <T k="home.seeAll" /> &rarr;
      </a>
    </div>
    <div class="grid gap-4">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Layout>
