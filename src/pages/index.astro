---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { getAllBlogs, getAllScraps } from "../lib/microcms";
import T from "../components/T.astro";
import { socialLinks } from "../data/social";

const [allPosts, scraps] = await Promise.all([getAllBlogs(), getAllScraps()]);
const latest = allPosts.slice(0, 3);
const latestScraps = scraps.slice(0, 3);

const stats = [
  { key: "home.posts", value: allPosts.length, href: "/blog/" },
  { key: "home.scraps", value: scraps.length, href: "/scraps/" },
] as const;
---

<Layout>
  <!--
    名前を紙の幅いっぱいに合わせる。読み込み時に字幅が縮んだ状態から伸び、
    上の寸法線が実際の文字幅を測りながら追従する（src/pages/index.astro の script）。
  -->
  <section class="hero" aria-labelledby="hero-name" data-state="static">
    <div class="hero-dim" aria-hidden="true">
      <div class="dim" id="hero-dim"><span id="hero-dim-value">W —</span></div>
    </div>
    <h1 id="hero-name" class="hero-name">
      <span class="hero-line" data-fit>Nknight</span>
      <span class="hero-line" data-fit>AMAMIYA</span>
    </h1>
    <p class="hero-handle note" aria-hidden="true">
      <span>@nk4dev</span>
      <span>Archivo, wdth <span id="hero-wdth">125</span></span>
    </p>
    <script is:inline>
      // JS が動く環境だけ、フォント読み込みまで名前を隠して伸びる演出を準備する
      document.currentScript.parentElement.dataset.state = "pending";
    </script>
  </section>

  <section class="intro" aria-label="Profile">
    <figure class="intro-figure">
      <div class="bp p-1" data-bp="avatar">
        <img src="/icon.jpeg" alt="Nknight AMAMIYA" width="120" height="120" class="block size-[120px] object-cover" />
      </div>
      <figcaption class="dim mt-2" aria-hidden="true">120 × 120</figcaption>
    </figure>

    <div class="intro-body">
      <p class="intro-bio">
        <T k="home.bio1" />
        <br />
        <T k="home.bio2" />
      </p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          socialLinks.map((link) => (
            <li>
              <a href={`/${link.slug}`} class="social" rel="me">
                <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
                  <path d={link.icon} />
                </svg>
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <dl class="intro-stats">
      {
        stats.map((stat) => (
          <div>
            <dt class="note">
              <T k={stat.key} />
            </dt>
            <dd>
              <a href={stat.href} class="stat-value">
                {String(stat.value).padStart(2, "0")}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mt-24" aria-labelledby="latest-heading">
    <div class="section-head">
      <h2 id="latest-heading" class="section-title"><T k="home.latest" /></h2>
      <a href="/blog/" class="text-link note"><T k="home.seeAll" /></a>
    </div>
    <ol class="entries">
      {latest.map((post) => <PostCard post={post} no={allPosts.length - allPosts.indexOf(post)} />)}
    </ol>
  </section>

  {
    latestScraps.length > 0 && (
      <section class="mt-20" aria-labelledby="scraps-heading">
        <div class="section-head">
          <h2 id="scraps-heading" class="section-title">
            <T k="home.scraps" />
          </h2>
          <a href="/scraps/" class="text-link note">
            <T k="home.seeAll" />
          </a>
        </div>
        <ol class="entries">
          {latestScraps.map((scrap, i) => (
            <PostCard post={scrap} no={scraps.length - i} basePath="/scraps" />
          ))}
        </ol>
      </section>
    )
  }
</Layout>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  const lines = Array.from(document.querySelectorAll<HTMLElement>("[data-fit]"));
  const dim = document.getElementById("hero-dim");
  const dimValue = document.getElementById("hero-dim-value");
  const wdthLabel = document.getElementById("hero-wdth");

  /** 各行を、字幅 125 のときに紙の幅ちょうどになる文字サイズにする */
  const fit = () => {
    if (!hero) return;
    const width = hero.clientWidth;
    for (const line of lines) {
      line.style.fontSize = "100px";
      line.style.fontStretch = "125%";
      let size = (100 * width) / line.getBoundingClientRect().width;
      line.style.fontSize = `${size}px`;
      // 字詰めやヒンティングで大きさと幅が比例しきらない分を 1 回補正する
      size *= width / line.getBoundingClientRect().width;
      line.style.fontSize = `${size}px`;
      line.style.fontStretch = "";
    }
  };

  /** 寸法線を一番長い行の実測幅に合わせる */
  const measure = () => {
    if (!dim || !dimValue) return;
    const w = Math.max(...lines.map((l) => l.getBoundingClientRect().width));
    dim.style.width = `${w}px`;
    dimValue.textContent = `W ${w.toFixed(1)}`;
    if (wdthLabel) {
      const stretch = parseFloat(getComputedStyle(lines[0]).fontStretch) || 125;
      wdthLabel.textContent = Math.round(stretch).toString();
    }
  };

  const start = () => {
    if (!hero || hero.dataset.state === "drawing" || hero.dataset.state === "done") return;
    fit();
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      hero.dataset.state = "done";
      measure();
      return;
    }
    hero.dataset.state = "drawing";
    // 字幅のアニメーション中は毎フレーム測り直す
    const tick = () => {
      measure();
      if (hero.dataset.state === "drawing") requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    const finish = () => {
      if (hero.dataset.state !== "drawing") return;
      hero.dataset.state = "done";
      measure();
    };
    lines[lines.length - 1]?.addEventListener("animationend", finish, { once: true });
    // animationend が来ない環境（非表示タブなど）でも必ず完了させる
    setTimeout(finish, 2000);
  };

  // フォントが読み込めなくても 2 秒で表示する
  Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 2000))]).then(start);

  // スマホのアドレスバーの伸縮など、高さだけの変化では合わせ直さない
  let lastWidth = 0;
  new ResizeObserver(([entry]) => {
    const width = entry.contentRect.width;
    if (width === lastWidth) return;
    lastWidth = width;
    if (hero?.dataset.state === "done") {
      fit();
      measure();
    }
  }).observe(hero!);
</script>

<style>
  .hero {
    position: relative;
  }
  .hero-dim {
    height: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .hero-dim .dim {
    width: 100%;
  }
  .hero-name {
    display: flex;
    flex-direction: column;
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.02em;
    /* JS が無いときのおおよそのサイズ */
    font-size: clamp(3.5rem, 17.5vw, 13.5rem);
  }
  .hero-line {
    display: block;
    width: fit-content;
    white-space: nowrap;
    /* 行ボックスをキャップハイト〜ベースラインに切り詰め、補助線を文字にぴったり合わせる */
    text-box: trim-both cap alphabetic;
    padding-block: 0.02em;
    border-block: 1px dashed var(--line);
  }
  /* 1 行目の g のディセンダーが 2 行目に当たらないだけ空ける */
  .hero-line + .hero-line {
    margin-top: 0.3em;
  }
  .hero-handle {
    display: flex;
    justify-content: space-between;
    margin-top: 1rem;
    color: var(--ink-soft);
  }

  .hero[data-state="pending"] .hero-name,
  .hero[data-state="pending"] .hero-dim {
    visibility: hidden;
  }
  .hero[data-state="drawing"] .hero-line {
    animation: stretch 1500ms cubic-bezier(0.7, 0, 0.15, 1) both;
  }
  .hero[data-state="drawing"] .hero-line + .hero-line {
    animation-delay: 120ms;
  }
  .hero[data-state="drawing"] .hero-dim {
    animation: fade 400ms ease-out both;
  }
  @keyframes stretch {
    from {
      font-stretch: 62.5%;
      border-color: transparent;
    }
    60% {
      border-color: var(--line);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .intro {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "figure stats"
      "body body";
    gap: 2.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line-strong);
  }
  .intro-figure {
    grid-area: figure;
    width: 130px;
  }
  .intro-body {
    grid-area: body;
  }
  .intro-bio {
    max-width: 30em;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: -0.01em;
  }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line);
    font: 400 0.75rem/1 var(--font-mono);
    transition:
      border-color 200ms,
      background-color 200ms;
  }
  .social:hover {
    border-color: var(--red);
    background: var(--grid-major);
  }
  .intro-stats {
    grid-area: stats;
    display: flex;
    justify-content: flex-end;
    gap: 2rem;
  }
  .stat-value {
    display: block;
    font-size: 3.5rem;
    font-weight: 300;
    font-stretch: 62.5%;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    transition:
      font-stretch 400ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 200ms;
  }
  .stat-value:hover {
    font-stretch: 125%;
    color: var(--red);
  }
  @media (min-width: 768px) {
    .intro {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "figure body stats";
      align-items: start;
      margin-top: 4.5rem;
    }
  }
</style>
