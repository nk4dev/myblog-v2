{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "blog-v2",
	"main": "./src/worker.ts",
	// Serve the site on nknighta.me (replacing the old Next.js worker there).
	// blog.nknighta.me stays attached so its DNS keeps resolving; a Cloudflare Redirect Rule on the
	// zone sends it to nknighta.me. Static pages are served before the Worker runs, so the Worker
	// cannot do that redirect itself (and run_worker_first would break `astro dev`)
	"routes": [
		{ "pattern": "nknighta.me", "custom_domain": true },
		{ "pattern": "blog.nknighta.me", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
