{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "blog-v2",
	"main": "./src/worker.ts",
	// Serve the site on nknighta.me (replacing the old Next.js worker there).
	// blog.nknighta.me is not attached here: it has its own DNS record, and a Cloudflare Redirect
	// Rule on the zone sends it to nknighta.me. Attaching it as a custom domain fails while that
	// record exists (API error 100117)
	"routes": [{ "pattern": "nknighta.me", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Prerendered pages are served straight from the assets unless the Worker runs first.
		// Run it for them so requests with Accept: text/markdown get Markdown (src/server/markdown.ts).
		// Keep this in step with the pages that are not rendered on demand (prerender = false)
		"run_worker_first": [
			"/about/*",
			"/apps/*",
			"/developers/*",
			"/links/*",
			"/llmassets/",
			"/privacy/*",
			"/social/*"
		]
	},
	"observability": {
		"enabled": true
	}
}
